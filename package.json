{
  "name": "adapter-vercel",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "turbo build",
    "format": "biome format --write && biome check --fix",
    "prepare": "husky",
    "typecheck": "biome check",
    "clean": "turbo clean",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.5",
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.29.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,jsonc}": [
      "biome format --write",
      "biome check --fix"
    ]
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.5.2"
}
