{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "GOPATH",
    "GOMODCACHE",
    "GOCACHE",
    "USERPROFILE",
    "LOCALAPPDATA",
    "HOMEDRIVE",
    "HOMEPATH",
    "SystemRoot",
    "SYSTEMROOT",
    "COMSPEC",
    "PATHEXT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
